# codey README screenshot 3: the help overlay
# shot: 3.png
# theme: catppuccin-frappe

Set FontFamily "Maple Mono NF CN"
Set FontSize 16
Set Width 1600
Set Height 1000
Set Padding 0
Set CursorBlink false
Set Theme { "background": "#303446", "foreground": "#c6d0f5", "cursor": "#f2d5cf", "cursor_text": "#303446", "selection_background": "#626880", "selection_foreground": "#c6d0f5", "black": "#626880", "red": "#e78284", "green": "#a6d189", "yellow": "#e5c890", "blue": "#8caaee", "magenta": "#f4b8e4", "cyan": "#81c8be", "white": "#a5adce", "bright_black": "#838ba7", "bright_red": "#ea999c", "bright_green": "#b1dcc1", "bright_yellow": "#f2d5cf", "bright_blue": "#85c1dc", "bright_magenta": "#ca9ee6", "bright_cyan": "#99d1db", "bright_white": "#babbf1" }

Hide
Type "codey"
Enter
Show
Sleep 3s

Type "?"
Sleep 1s

Screenshot "shots/3.png"
