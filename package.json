{
  "name": "@rodey-io/codey",
  "version": "0.1.2",
  "description": "Review-first git TUI: two-section staged/changes diff viewer with transient comments and real git staging. Built on OpenTUI.",
  "homepage": "https://github.com/rodeyseijkens/codey",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodeyseijkens/codey.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "codey": "./bin/codey.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "bench": "bun run scripts/bench.ts",
    "build": "bun run scripts/build-bin.ts",
    "bump-deps": "pnpx npm-check-updates --deep -u && (pnpx pnpm-catalog-updates update || true) && pnpm up --latest",
    "dev": "bun run src/main.tsx",
    "format": "ultracite format",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "start": "bun run src/main.tsx",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/keymap": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@pierre/diffs": "1.3.6",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "get-east-asian-width": "^1.6.0",
    "react": "^19.2.8",
    "shell-quote": "1.10.0",
    "smol-toml": "^1.8.0",
    "string-width": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/shell-quote": "^1.7.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.7"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.17.1"
  }
}
