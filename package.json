{
  "name": "codey",
  "version": "0.1.0",
  "description": "Review-first git TUI: two-section staged/changes diff viewer with transient comments and real git staging. Built on OpenTUI.",
  "type": "module",
  "bin": {
    "codey": "./bin/codey.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "bench": "bun run scripts/bench.ts",
    "build": "bun run scripts/build-bin.ts",
    "dev": "bun run src/main.tsx",
    "format": "ultracite format",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "start": "bun run src/main.tsx",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "@pierre/diffs": "1.2.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "diff": "^8.0.3",
    "get-east-asian-width": "^1.6.0",
    "react": "^19.2.8",
    "shell-quote": "1.9.0",
    "smol-toml": "^1.7.1",
    "string-width": "^8.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/shell-quote": "^1.7.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.9",
    "typescript": "^5.6.0",
    "ultracite": "^7.10.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.17.1"
  }
}
