{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "*.jsonc",
      "*.mjs",
      "*.ts",
      "!src/ui/hunk-diff/core",
      "!src/ui/hunk-diff/ui",
      "!src/ui/hunk-diff/lib",
      "!src/ui/hunk-diff/opentui"
    ]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "style": {
        "noUselessElse": "error",
        "useConsistentCurlyBraces": "error",
        "useBlockStatements": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": ["camelCase", "kebab-case"]
          }
        },
        "noExportedImports": "warn",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useErrorCause": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noVoid": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noShadowRestrictedNames": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": [
              "error",
              "warn",
              "info",
              "debug",
              "trace",
              "time",
              "timeEnd"
            ]
          }
        },
        "noLeakedRender": "off"
      },
      "correctness": {
        "noSwitchDeclarations": "error"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "trailingCommas": "all",
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // Fire-and-forget async (dispatch handlers, watcher teardown) is
      // intentional in the TUI event loop; `void promise` expresses it best.
      "includes": ["src/state/dispatch.ts", "src/main.tsx", "src/watch.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noVoid": "off"
          }
        }
      }
    },
    {
      // OpenTUI renderables use custom event props (onMouse, onKeyDown, ...)
      // and per-row handler closures; the DOM-focused React rules flag these
      // as unknown attributes / prop binds / static interactions, which are
      // false positives here (there is no ARIA role model in a terminal UI).
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          },
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/herdr/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ["react"],
              ["next", "next/**"],
              ["expo", "expo/**"],
              [":PACKAGE:", "!@repo/**"],
              ":BLANK_LINE:",
              [":ALIAS:", "@repo/**"],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  }
}
